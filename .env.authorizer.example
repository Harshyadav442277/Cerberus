# Copy to .env.authorizer. The API/control-plane process uses this key to issue
# Execution Authorizations. It authorizes no x402 USDC payment and writes no audit
# anchor: the audit-anchor signer lives only in .env.anchor, read only by the trusted
# anchor worker, so nothing that can grant spending authority can also author its own
# audit proof.
CONTROL_PLANE_DATABASE_URL=postgres://cerberus_control_app:CHANGE_ME_16_CHARS_MIN@localhost:5544/safr_runtime
EXECUTION_AUTH_PRIVATE_KEY=

# Shared only with the agent service. Authenticates requests to the capability issuer;
# use a distinct high-entropy value, never the signing key or reviewer token.
EXECUTION_API_TOKEN=

# Authenticates the dashboard server and trusted reviewer process to /decision.
# Generate a high-entropy value; never use NEXT_PUBLIC_ for this credential.
REVIEWER_API_TOKEN=
REVIEWER_ID=compliance_officer_01
