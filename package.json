{
  "name": "safr-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "SAFR Runtime — enforces MAS's SAFR governance pattern in real time, gating an AI agent's stablecoin payments before they execute.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 --test-timeout=60000 packages/core/src/__tests__/*.test.ts packages/disposition-engine/src/__tests__/*.test.ts packages/execution-authorization/src/__tests__/*.test.ts packages/x402-client/src/__tests__/*.test.ts packages/db/src/__tests__/*.test.ts packages/audit-log/src/__tests__/*.test.ts apps/agent/src/__tests__/*.test.ts apps/executor/src/__tests__/*.test.ts contracts/src/__tests__/*.test.ts apps/api/src/__tests__/*.test.ts apps/dashboard/lib/*.test.ts",
    "adversarial": "tsx scripts/adversarial.ts",
    "redteam": "tsx scripts/redteam.ts",
    "demo": "tsx apps/agent/src/cli/run.ts",
    "demo:reset": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/reset-demo.ts",
    "demo:script": "tsx scripts/demo.ts",
    "api": "tsx apps/api/src/server.ts",
    "executor": "tsx apps/executor/src/server.ts",
    "reconciler": "tsx apps/executor/src/reconcile-cli.ts",
    "anchor": "node --env-file-if-exists=.env --import tsx packages/audit-log/src/cli/anchor-worker.ts",
    "anchor:once": "node --env-file-if-exists=.env --import tsx packages/audit-log/src/cli/anchor-worker.ts --once",
    "reviewer:auto": "tsx apps/reviewer/src/index.ts",
    "dashboard": "npm run dev --prefix apps/dashboard",
    "contracts:compile": "tsx contracts/src/compile.ts",
    "contracts:deploy": "tsx contracts/src/deploy.ts",
    "audit:verify": "node --env-file-if-exists=.env --import tsx packages/audit-log/src/cli/verify-anchors.ts",
    "audit:tamper-demo": "node --env-file-if-exists=.env --import tsx packages/audit-log/src/cli/tamper-demo.ts",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/migrate.ts up",
    "db:migrate:down": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/migrate.ts down",
    "db:migrate:status": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/migrate.ts status",
    "db:roles": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/provision-roles.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/seed.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/verify.ts",
    "merchant": "tsx apps/merchant/src/server.ts",
    "phase1": "tsx packages/x402-client/scripts/phase1-pay.ts",
    "phase1:preflight": "tsx packages/x402-client/scripts/preflight.ts",
    "wallets:new": "tsx packages/x402-client/scripts/gen-wallets.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
