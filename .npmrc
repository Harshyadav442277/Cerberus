# Keep pnpm's content-addressable store inside the workspace. The default
# location (~/.local/share/pnpm/store) is outside the project and is not
# writable in some sandboxed/CI environments, where pnpm then hangs silently
# on install rather than erroring.
store-dir=.pnpm-store

# Surface registry problems as errors instead of hanging.
fetch-retries=2
fetch-timeout=60000

# Note: onlyBuiltDependencies and confirmModulesPurge live in pnpm-workspace.yaml,
# not here — pnpm 10 moved those settings out of .npmrc.
