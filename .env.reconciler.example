# Copy to .env.reconciler. This keyless worker inherits cerberus_executor_role for
# settlement-state transitions but never loads the x402 payment private key.
RECONCILER_DATABASE_URL=postgres://cerberus_reconciler_app:CHANGE_ME_16_CHARS_MIN@localhost:5544/safr_runtime

# Public read-only RPC. The worker never reads the root operator .env.
EVM_RPC_URL=https://sepolia.base.org
