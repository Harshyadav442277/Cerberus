# Copy to .env.anchor. Loaded ONLY by the trusted anchor worker (`npm run anchor`).
#
# This is the only process that may author final audit proof. It re-reads each audit
# record from Postgres, computes the digest itself, and writes it to the AuditAnchor
# contract. The untrusted agent must never receive this file.
#
# It holds no spending authority: no x402 payment key, no Execution Authorization
# key, and no reviewer credential. Its database role can read audit_log and write
# audit_anchor, and cannot touch payment_reservation or execution_authorization.

# Least-privilege login. Provision it with `npm run db:roles`; never use DATABASE_URL.
ANCHOR_DATABASE_URL=postgres://cerberus_anchor_app:CHANGE_ME_16_CHARS_MIN@localhost:5544/safr_runtime

# The audit-anchor signer. Generate with `npm run wallets:new`.
AUDIT_ANCHOR_PRIVATE_KEY=
AUDIT_ANCHOR_ADDRESS=

EVM_RPC_URL=https://sepolia.base.org

# How often the continuous worker polls an empty outbox, in milliseconds.
ANCHOR_POLL_MS=1000
