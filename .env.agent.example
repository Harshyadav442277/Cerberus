# Copy to .env.agent. This is the only environment file apps/agent reads.
# It may contain public endpoints plus the LLM credential.
#
# Never place ANY signing key here:
#   - the x402 payment key            (isolated executor only)
#   - the Execution Authorization key (control plane only)
#   - the audit-anchor key            (trusted anchor worker only)
#
# The audit-anchor key in particular authors final audit proof. An agent holding it
# could manufacture evidence of its own good behaviour, so the untrusted process must
# genuinely lack it. AUDIT_ANCHOR_ADDRESS below is a public contract address, not a
# credential, and is kept only so the agent can display anchor state.
#
# Never place reviewer API or dashboard credentials here either.

# Least-privilege login. Provision it with `npm run db:roles`; never use DATABASE_URL.
AGENT_DATABASE_URL=postgres://cerberus_agent_app:CHANGE_ME_16_CHARS_MIN@localhost:5544/safr_runtime

NEXT_PUBLIC_API_URL=http://localhost:4050
EXECUTOR_URL=http://localhost:4060
MERCHANT_BASE_URL=http://localhost:4021
EVM_RPC_URL=https://sepolia.base.org
EXECUTOR_WALLET_ADDRESS=

ANTHROPIC_API_KEY=
AUDIT_ANCHOR_ADDRESS=
