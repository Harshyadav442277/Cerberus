# Copy to apps/dashboard/.env.local. Next.js reads this only on the server unless a
# variable is explicitly prefixed NEXT_PUBLIC_. Never add that prefix to this token.

CERBERUS_API_URL=http://localhost:4050
REVIEWER_API_TOKEN=

# Fixed-scenario presenter adapter. The bearer is server-to-server only and must be
# different from both Cerberus authority tokens and the reviewer credential.
CERBERUS_PRESENTER_URL=http://localhost:4070
JUDGE_RUNNER_API_TOKEN=

# Optional read-only RPC override. No signer is used by the Judge Console.
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# The browser prompts once for these credentials when /escalations is opened. The
# password is retained by the browser's HTTP-auth mechanism, not client JavaScript.
REVIEWER_DASHBOARD_USERNAME=reviewer
REVIEWER_DASHBOARD_PASSWORD=
