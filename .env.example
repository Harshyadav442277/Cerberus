# SAFR Runtime — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit a real private key.

# ---------------------------------------------------------------------------
# Database (Phase 2 onward). Matches docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://safr:safr@localhost:5544/safr_runtime

# ---------------------------------------------------------------------------
# x402 / Base Sepolia (Phase 1 onward)
# ---------------------------------------------------------------------------

# Payer wallet — the agent's wallet. Must hold Base Sepolia USDC (to pay) and a
# little Sepolia ETH (for gas on the Phase 5 audit anchor contract).
# Faucets: https://faucet.circle.com (USDC) and any Base Sepolia ETH faucet.
EVM_PRIVATE_KEY=

# Payee wallet — the merchant's receiving address. For local testing this can be
# any address you control; it does not need funding.
EVM_ADDRESS=

# Base Sepolia, CAIP-2 format. Do not change to mainnet.
X402_NETWORK=eip155:84532
EVM_RPC_URL=https://sepolia.base.org

# Testnet facilitator. Per x402 docs, never reuse this URL for mainnet routes.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Local merchant resource server (apps/merchant)
MERCHANT_PORT=4021
MERCHANT_BASE_URL=http://localhost:4021

# ---------------------------------------------------------------------------
# Agent LLM (Phase 4 onward). Only used to generate Proposed Action objects.
# Never used in the Disposition Engine — see Rules.md R3.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Audit anchor contract (Phase 5). Set after deploying contracts/AuditAnchor.sol.
# ---------------------------------------------------------------------------
AUDIT_ANCHOR_ADDRESS=
