# SAFR Runtime — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit a real private key.

# ---------------------------------------------------------------------------
# Database schema-owner credential. Used only by migration, seed, reset, role
# provisioning, and tests. Application processes must use their dedicated URLs from
# .env.agent, .env.authorizer, and .env.executor instead.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://safr:safr@localhost:5544/safr_runtime

# ---------------------------------------------------------------------------
# x402 / Base Sepolia (Phase 1 onward)
# ---------------------------------------------------------------------------

# Payee wallet — the merchant's receiving address. For local testing this can be
# any address you control; it does not need funding.
EVM_ADDRESS=

# Public identities only. Private keys live in the process-specific ignored files
# .env.executor and .env.authorizer; the agent process must never receive them.
EXECUTOR_WALLET_ADDRESS=
EXECUTION_AUTHORIZER_ADDRESS=

# Base Sepolia, CAIP-2 format. Do not change to mainnet.
X402_NETWORK=eip155:84532
EVM_RPC_URL=https://sepolia.base.org

# Testnet facilitator. Per x402 docs, never reuse this URL for mainnet routes.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Local merchant resource server (apps/merchant)
MERCHANT_PORT=4021
MERCHANT_BASE_URL=http://localhost:4021

# Dashboard API (apps/api) — Phase 6
API_PORT=4050
NEXT_PUBLIC_API_URL=http://localhost:4050
# Comma-separated browser origins permitted to read API responses.
API_CORS_ORIGINS=http://localhost:3000

# Isolated payment executor (apps/executor)
EXECUTOR_PORT=4060
EXECUTOR_URL=http://localhost:4060

# ---------------------------------------------------------------------------
# Public audit anchor contract address. Also copy it to .env.agent so the agent's
# asynchronous anchor client can use it.
# ---------------------------------------------------------------------------
AUDIT_ANCHOR_ADDRESS=
