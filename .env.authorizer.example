# Copy to .env.authorizer. The API/control-plane process uses the first key to issue
# Execution Authorizations. The second key is only for audit-anchor transactions.
# Neither key authorizes x402 USDC payments.
CONTROL_PLANE_DATABASE_URL=postgres://cerberus_control_app:CHANGE_ME_16_CHARS_MIN@localhost:5544/safr_runtime
EXECUTION_AUTH_PRIVATE_KEY=
AUDIT_ANCHOR_PRIVATE_KEY=

# Authenticates the dashboard server and trusted reviewer process to /decision.
# Generate a high-entropy value; never use NEXT_PUBLIC_ for this credential.
REVIEWER_API_TOKEN=
REVIEWER_ID=compliance_officer_01
