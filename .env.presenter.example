# Least-privilege hostile-agent role. Never use DATABASE_URL or a schema-owner URL.
AGENT_DATABASE_URL=
EXECUTION_API_TOKEN=

# Existing Cerberus services used by the normal orchestrator adapters.
NEXT_PUBLIC_API_URL=
EXECUTOR_URL=
MERCHANT_BASE_URL=

# Dedicated server-to-server presentation credential. Not a Cerberus authority token.
JUDGE_RUNNER_API_TOKEN=

# Public/read-only configuration only.
EVM_RPC_URL=
AUDIT_ANCHOR_ADDRESS=

# Persistent presenter process listener.
PRESENTER_PORT=
PRESENTER_BIND_HOST=
